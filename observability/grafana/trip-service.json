      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{exported_job=\"tripgo/trip-service\"}[5m]))",
          "legendFormat": "HTTP {{http_response_status_code}}"
        }
      ]
